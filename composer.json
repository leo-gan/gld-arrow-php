{
  "name": "leo-gan/gld-arrow-php",
  "description": "From-scratch Apache Arrow IPC, tensor, and Flight messages for PHP.",
  "keywords": ["arrow", "serialization", "ipc"],
  "homepage": "https://leo-gan.github.io/gld-arrow-php/",
  "type": "library",
  "license": "MIT",
  "version": "0.2.0",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Gld\\Arrow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gld\\Arrow\\Generated\\": "tests/generated/"
    }
  },
  "bin": [
    "bin/gld-arrowgen-php"
  ],
  "authors": [
    {
      "name": "Leonid Ganeline",
      "email": "leo.gan.57@gmail.com"
    }
  ],
  "scripts": {
    "test": "php tests/run.php"
  }
}
