{
  "name": "leo-gan/gld-arrow-php",
  "description": "From-scratch Apache Arrow IPC, tensor, and Flight messages for PHP.",
  "type": "library",
  "license": "MIT",
  "version": "0.1.0",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Gld\\Arrow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gld\\Arrow\\Generated\\": "tests/generated/"
    }
  },
  "bin": [
    "bin/gld-arrowgen-php"
  ],
  "scripts": {
    "test": "php tests/run.php"
  }
}
